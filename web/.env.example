# Copy to web/.env.local (git-ignored) and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key registered in App Check for the hosted domain.
VITE_RECAPTCHA_SITE_KEY=
# Set to "true" only on your own machine for local dev. The debug token itself is printed
# in the browser console and registered in the Firebase console. Never commit it.
VITE_APPCHECK_DEBUG=false
