rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A saved offer belongs to one signed-in (anonymous) user. Nobody else can
    // read, list or write it. Everything else in the database is closed.
    match /users/{uid}/proofs/{proofId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      // Each saved quote is a small map of short strings. Rules have no loops,
      // so items are checked one by one, and a proof keeps at most 10 quotes.
      function quoteOk(q, i) {
        return q.size() <= i || (
          q[i] is map
          && q[i].keys().hasOnly(['kind', 'quote', 'amount'])
          && q[i].kind is string && q[i].kind.size() <= 30
          && q[i].quote is string && q[i].quote.size() <= 500
          && (!('amount' in q[i]) || (q[i].amount is string && q[i].amount.size() <= 20)));
      }
      function validProof() {
        let d = request.resource.data;
        return d.keys().hasOnly(['site', 'capturedAt', 'remindOn', 'quotes', 'sha256', 'savedAt'])
          && d.keys().hasAll(['site', 'capturedAt', 'quotes', 'sha256'])
          && d.site is string && d.site.size() <= 253
          && d.capturedAt is string && d.capturedAt.size() <= 40
          && d.capturedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*')
          && (!('remindOn' in d) || (d.remindOn is string && d.remindOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.quotes is list
          && quoteOk(d.quotes, 0) && quoteOk(d.quotes, 1) && quoteOk(d.quotes, 2) && quoteOk(d.quotes, 3)
          && quoteOk(d.quotes, 4) && quoteOk(d.quotes, 5) && quoteOk(d.quotes, 6) && quoteOk(d.quotes, 7)
          && quoteOk(d.quotes, 8) && quoteOk(d.quotes, 9) && d.quotes.size() <= 10
          && d.sha256 is string && d.sha256.size() == 64
          && d.savedAt == request.time;
      }
      allow read, delete: if isOwner();
      allow create: if isOwner() && validProof();
      allow update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
